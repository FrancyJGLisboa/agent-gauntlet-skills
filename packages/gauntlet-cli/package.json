{
  "name": "@promptcompletion/cli",
  "version": "0.6.0",
  "description": "Deterministic policy and state engine for Agent Gauntlet packs",
  "type": "module",
  "author": "Francy Lisboa",
  "license": "MIT",
  "homepage": "https://github.com/FrancyJGLisboa/agent-gauntlet-skills#readme",
  "bugs": {
    "url": "https://github.com/FrancyJGLisboa/agent-gauntlet-skills/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancyJGLisboa/agent-gauntlet-skills.git",
    "directory": "packages/gauntlet-cli"
  },
  "keywords": [
    "agent",
    "ai",
    "claude",
    "codex",
    "copilot",
    "verification",
    "builder-critic",
    "evidence",
    "orchestration"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "gauntlet": "src/cli.js"
  },
  "files": [
    "src",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "test:conformance": "node --test test/engine.test.js",
    "test:reference": "node --test test/reference-example.test.js",
    "test:skills": "node scripts/validate-skills.mjs ../../skills",
    "test:agent-docs": "node scripts/verify-agent-docs.mjs ../..",
    "test:package": "node scripts/verify-package.mjs .",
    "prepublishOnly": "npm test && npm run test:package"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=24"
  }
}
