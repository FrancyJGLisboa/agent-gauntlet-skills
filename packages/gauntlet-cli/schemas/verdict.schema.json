{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-gauntlet.dev/schemas/verdict.schema.json",
  "type": "object",
  "required": ["verdict", "actor", "evidence", "reason"],
  "properties": {
    "verdict": { "enum": ["pass", "fail", "blocked", "repair"] },
    "actor": { "enum": ["critic", "verifier"] },
    "evidence": { "type": "array", "minItems": 1 },
    "reason": { "type": "string", "minLength": 1 }
  }
}
