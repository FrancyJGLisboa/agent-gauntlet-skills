{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-gauntlet.dev/schemas/evidence.schema.json",
  "type": "object",
  "required": ["evidence_id", "assignment_id", "slice_id", "test_id", "pack_fingerprint", "command", "cwd", "exit_code", "stdout_sha256", "stderr_sha256"],
  "properties": {
    "pack_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "exit_code": { "type": ["integer", "null"] },
    "stdout_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stderr_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
